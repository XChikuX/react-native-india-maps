{
  "name": "react-native-india-maps",
  "version": "0.6.0",
  "description": "React Native SDK for India Maps using MapLibre GL with Ola Maps and Mappls (MapMyIndia) APIs",
  "source": "./src/index.ts",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./plugin": "./app.plugin.js"
  },
  "files": [
    "src",
    "lib",
    "plugin",
    "app.plugin.js",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "build": "bob build",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "release": "release-it"
  },
  "keywords": [
    "react-native",
    "expo",
    "india-maps",
    "maplibre",
    "ola-maps",
    "mappls",
    "mapmyindia",
    "maps",
    "location",
    "routing",
    "geocoding",
    "geofence"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XChikuX/react-native-ola-maps.git"
  },
  "author": "XChikuX",
  "license": "LGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/XChikuX/react-native-ola-maps/issues"
  },
  "homepage": "https://github.com/XChikuX/react-native-ola-maps#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.2",
    "@evilmartians/lefthook": "^2.1.12",
    "@expo/config-plugins": "^55.0.11",
    "@maplibre/maplibre-react-native": "^11.5.0",
    "@react-native/babel-preset": "0.83.10",
    "@react-native/eslint-config": "0.83.10",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/geojson": "^7946.0.16",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.18",
    "@types/react-test-renderer": "^19.1.0",
    "commitlint": "^21.2.3",
    "del-cli": "^7.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "react": "^19.2.8",
    "react-native": "~0.83.10",
    "react-native-builder-bob": "^0.43.1",
    "react-test-renderer": "19.2.8",
    "release-it": "^21.1.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@expo/config-plugins": ">=55.0.0",
    "@maplibre/maplibre-react-native": ">=11.2.0",
    "react": ">=19.2.0",
    "react-native": ">=0.83.0"
  },
  "peerDependenciesMeta": {
    "@expo/config-plugins": {
      "optional": true
    },
    "@maplibre/maplibre-react-native": {
      "optional": false
    }
  },
  "packageManager": "bun@1.3.14",
  "jest": {
    "preset": "react-native",
    "clearMocks": true,
    "setupFiles": [
      "./test/jest.setup.js"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/lib/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native|@maplibre)/)"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native",
      "plugin:prettier/recommended"
    ],
    "rules": {
      "react/react-in-jsx-scope": "off",
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "./tsconfig.build.json"
        }
      ]
    ]
  }
}
